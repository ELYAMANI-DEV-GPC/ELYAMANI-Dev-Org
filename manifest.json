{
  "manifest_version": 3,
  "name": "Play Console Draft Creator",
  "version": "1.0",
  "description": "Batch create draft apps on Google Play Console",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "sidePanel"],
  "host_permissions": ["https://play.google.com/*", "https://generativelanguage.googleapis.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Play Console Draft Creator",
    "default_icon": "icon128.png"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "icons": {
    "128": "icon128.png"
  },
  "web_accessible_resources": [{
    "resources": ["data_safety_default.csv"],
    "matches": ["<all_urls>"]
  }]
}
